{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/formacion/constelaciones", "destination": "/constelaciones-familiares", "statusCode": 301 },
    { "source": "/formacion/biodescodificacion", "destination": "/biodescodificacion", "statusCode": 301 },
    { "source": "/sexualidad-consciente", "destination": "/constelaciones-familiares", "statusCode": 307 },
    { "source": "/formacion/sexualidad", "destination": "/constelaciones-familiares", "statusCode": 307 },
    { "source": "/sexualidad", "destination": "/constelaciones-familiares", "statusCode": 307 },
    { "source": "/constelaciones", "destination": "/constelaciones-familiares", "statusCode": 301 },
    { "source": "/privacidad", "destination": "/privacy", "statusCode": 301 },
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/sitemap-0.xml", "destination": "/sitemap.xml", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/videos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
