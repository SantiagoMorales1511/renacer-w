---
import Base from '../layouts/Base.astro'
import TestimonialCarousel from '../components/TestimonialCarousel.astro'
import TestimonialCard from '../components/TestimonialCard.astro'
import TestimonialDialog from '../components/TestimonialDialog.astro'
import CtaBand from '../components/CtaBand.astro'
import { videoTestimonials } from '../data/testimonials'
import ctaImg from '../assets/photos/certificados.jpg'
import ogImg from '../assets/photos/grupo-sentado-blanco.jpg'
---

<Base
  title="Testimonios · Centro de Formación Renacer"
  description="Estudiantes de Renacer cuentan, en video y con sus propias palabras, cómo vivieron sus formaciones en Constelaciones Familiares y Biodescodificación en Cali."
  ogImage={ogImg}
>
  <section class="grain">
    <div class="wrap pb-4 pt-10 sm:pb-6 sm:pt-16">
      <p class="eyebrow rise">Testimonios</p>
      <h1 class="display rise rise-2 mt-5 max-w-4xl">Historias <span class="accent">reales</span> de nuestros estudiantes.</h1>
      <p class="lead rise rise-3 mt-6 max-w-2xl">
        Quienes han sido parte de nuestras formaciones comparten, con sus propias palabras, cómo vivieron su proceso en Renacer.
      </p>
    </div>
  </section>

  <TestimonialCarousel items={videoTestimonials} id="carrusel" />

  <section class="bg-white py-16 sm:py-24" aria-labelledby="todos">
    <div class="wrap">
      <h2 id="todos" class="title text-center">Todos los <span class="accent">testimonios</span></h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-ink-soft">{videoTestimonials.length} videos. Toca cualquiera para verlo con sonido.</p>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
        {
          videoTestimonials.map((t) => (
            <li>
              <TestimonialCard item={t} sizes="(min-width: 1024px) 270px, (min-width: 768px) 33vw, 50vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Reproductor grande para la cuadrícula -->
  <TestimonialDialog />

  <CtaBand
    waKey="general"
    title="Tu proceso también <span class='accent text-lavender'>puede empezar aquí.</span>"
    text="Escríbenos y te contamos qué formación se ajusta a lo que buscas."
    image={ctaImg}
    imageAlt="Estudiantes de Renacer con sus certificados"
  />
</Base>
