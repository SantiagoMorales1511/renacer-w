---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Icon from './Icon.astro'
import { waLink, type WaKey } from '../lib/whatsapp'
import { site } from '../data/site'

interface Props {
  waKey: WaKey
  eyebrow?: string
  title: string
  text: string
  button?: string
  image: ImageMetadata
  imageAlt: string
}
const { waKey, eyebrow = 'Hablemos', title, text, button = 'Escribir por WhatsApp', image, imageAlt } = Astro.props
---

<section class="section pt-0">
  <div class="wrap">
    <div class="night-glow relative overflow-hidden rounded-[2rem] bg-petrol-night text-cream md:grid md:grid-cols-12">
      <div class="relative px-6 py-12 sm:px-12 sm:py-16 md:col-span-7">
        <p class="eyebrow eyebrow-light">{eyebrow}</p>
        <h2 class="title mt-5 text-cream" set:html={title} />
        <p class="mt-5 max-w-md text-[1.05rem] leading-relaxed text-cream/75">{text}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={waLink(waKey)} class="btn btn-light" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} />
            {button}
          </a>
          <span class="text-[0.85rem] text-cream/60 sm:ml-3">{site.whatsapp.display}</span>
        </div>
      </div>
      <div class="relative h-64 md:col-span-5 md:h-auto">
        <Picture
          src={image}
          alt={imageAlt}
          widths={[480, 800, 1100]}
          sizes="(min-width: 768px) 40vw, 100vw"
          formats={['avif', 'webp']}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-petrol-night/70 via-transparent md:bg-gradient-to-r md:from-petrol-night md:via-petrol-night/10"></div>
      </div>
    </div>
  </div>
</section>
