---
import { getImage } from 'astro:assets'
import Icon from './Icon.astro'
import { programLabel, type VideoTestimonial } from '../data/testimonials'

interface Props {
  item: VideoTestimonial
  sizes?: string
  /** Posterga la carga del poster hasta que el carrusel se acerque a la tarjeta */
  defer?: boolean
}
const { item, sizes = '(min-width: 768px) 280px, 74vw', defer = false } = Astro.props
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=='
const small = await getImage({ src: item.poster, width: 360, format: 'webp', quality: 70 })
const large = await getImage({ src: item.poster, width: 560, format: 'webp', quality: 72 })
const program = programLabel(item)
const srcset = `${small.src} 360w, ${large.src} 560w`
---

<button
  type="button"
  class="tc-card group"
  data-open
  data-full={item.src}
  data-preview={item.preview}
  data-poster={large.src}
  data-name={item.name}
  data-program={program}
  aria-label={`Ver con sonido el testimonio de ${item.name}, ${program}`}
>
  <span class="tc-media">
    <img
      src={defer ? blank : small.src}
      srcset={defer ? undefined : srcset}
      data-src={defer ? small.src : undefined}
      data-srcset={defer ? srcset : undefined}
      sizes={sizes}
      width={small.attributes.width}
      height={small.attributes.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="tc-slot" data-slot></span>
    <span class="tc-play" aria-hidden="true"><Icon name="play" size={22} class="ml-0.5" /></span>
  </span>
  <span class="tc-band">
    <span class="tc-progress" aria-hidden="true"><span data-bar></span></span>
    <span class="tc-name">{item.name}</span>
    <span class="tc-program">{program}</span>
    <span class="tc-sound" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5Z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
      Ver con sonido
    </span>
  </span>
</button>

<style is:global>
  .tc-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #2f4d7e;
    text-align: left;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tc-media {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #14243d;
  }
  .tc-media img,
  .tc-slot video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tc-slot video { opacity: 0; transition: opacity 0.35s ease; }
  .tc-slot video[data-ready] { opacity: 1; }
  .tc-play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(247, 246, 243, 0.95);
    color: #14243d;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }
  .tc-card:hover .tc-play { transform: translate(-50%, -50%) scale(1.05); }
  [data-playing] .tc-play { opacity: 0; }
  .tc-band {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 1rem 1rem;
    color: #f7f6f3;
  }
  .tc-progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: rgba(247, 246, 243, 0.18);
  }
  .tc-progress span {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: #f7f6f3;
  }
  .tc-name { font-size: 1rem; font-weight: 650; line-height: 1.25; }
  .tc-program { font-size: 0.78rem; line-height: 1.3; color: rgba(247, 246, 243, 0.78); }
  .tc-sound {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #f7f6f3;
  }
</style>
