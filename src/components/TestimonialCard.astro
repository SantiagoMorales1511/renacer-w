---
import { getImage } from 'astro:assets'
import Icon from './Icon.astro'
import { programLabel, type VideoTestimonial } from '../data/testimonials'

interface Props {
  item: VideoTestimonial
  sizes?: string
  /** Posterga la carga del poster hasta que el carrusel se acerque a la tarjeta */
  defer?: boolean
  /**
   * carousel: el video se reproduce dentro de la tarjeta y tocarlo activa/desactiva el sonido.
   * grid: tocar el video lo abre en el reproductor grande (TestimonialDialog).
   */
  variant?: 'carousel' | 'grid'
  /** Copia visual para el carrusel circular (sin foco ni lectores de pantalla) */
  clone?: boolean
}
const { item, sizes = '(min-width: 768px) 280px, 74vw', defer = false, variant = 'grid', clone = false } = Astro.props
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=='
const small = await getImage({ src: item.poster, width: 360, format: 'webp', quality: 70 })
const large = await getImage({ src: item.poster, width: 560, format: 'webp', quality: 72 })
const program = programLabel(item)
const srcset = `${small.src} 360w, ${large.src} 560w`
const inCarousel = variant === 'carousel'
const tab = clone ? -1 : undefined
---

<div
  class="tc-card group"
  data-card
  data-full={item.src}
  data-poster={large.src}
  data-name={item.name}
  data-program={program}
>
  <button
    type="button"
    class="tc-media"
    tabindex={tab}
    data-open={inCarousel ? undefined : ''}
    data-tap={inCarousel ? '' : undefined}
    data-full={inCarousel ? undefined : item.src}
    data-poster={inCarousel ? undefined : large.src}
    data-name={inCarousel ? undefined : item.name}
    data-program={inCarousel ? undefined : program}
    aria-label={inCarousel ? `Activar sonido del testimonio de ${item.name}` : `Abrir en grande el testimonio de ${item.name}, ${program}`}
    data-label-on={inCarousel ? `Silenciar el testimonio de ${item.name}` : undefined}
    data-label-off={inCarousel ? `Activar sonido del testimonio de ${item.name}` : undefined}
  >
    <img
      src={defer ? blank : small.src}
      srcset={defer ? undefined : srcset}
      data-src={defer ? small.src : undefined}
      data-srcset={defer ? srcset : undefined}
      sizes={sizes}
      width={small.attributes.width}
      height={small.attributes.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="tc-slot" data-slot></span>
    <span class="tc-play" aria-hidden="true"><Icon name="play" size={22} class="ml-0.5" /></span>
    {
      inCarousel ? (
        <>
          <span class="tc-film" aria-hidden="true" />
          <span class="tc-hint" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /></svg>
            Toca para activar el sonido
          </span>
          <span class="tc-hint tc-hint-on" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /></svg>
            Sonido activado
          </span>
        </>
      ) : (
        <span class="tc-expand" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg>
        </span>
      )
    }
  </button>
  <div class="tc-band">
    <span class="tc-progress" aria-hidden="true"><span data-bar></span></span>
    <span class="tc-name">{item.name}</span>
    <span class="tc-program">{program}</span>
  </div>
</div>

<style is:global>
  .tc-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #2f4d7e;
    text-align: left;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tc-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #14243d;
    -webkit-tap-highlight-color: transparent;
  }
  .tc-media img,
  .tc-slot video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tc-slot video { opacity: 0; transition: opacity 0.35s ease; }
  .tc-slot video[data-ready] { opacity: 1; }
  .tc-play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(247, 246, 243, 0.95);
    color: #14243d;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }
  .tc-media:hover .tc-play { transform: translate(-50%, -50%) scale(1.05); }
  [data-playing] .tc-play { opacity: 0; }
  .tc-expand {
    position: absolute;
    right: 0.7rem;
    top: 0.7rem;
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(20, 36, 61, 0.55);
    color: #f7f6f3;
  }
  /* Película mientras el audio está apagado: oscurece un poco todo el cuadro (que es la zona táctil) */
  .tc-film {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(20, 36, 61, 0.72) 0%, rgba(20, 36, 61, 0.42) 38%, rgba(20, 36, 61, 0.4) 100%);
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  /* Indicación sobre el video (carrusel): solo visual, el toque lo recibe todo el video */
  .tc-hint {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    display: inline-flex;
    max-width: calc(100% - 1.5rem);
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    border-radius: 9999px;
    background: rgba(20, 36, 61, 0.78);
    padding: 0.62rem 1rem 0.62rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: #fff;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  @media (max-width: 359px) { .tc-hint { font-size: 0.72rem; padding-inline: 0.75rem; } }
  .tc-band {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.1rem 1.15rem;
    color: #f7f6f3;
  }
  .tc-progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: rgba(247, 246, 243, 0.18);
  }
  .tc-progress span {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: #f7f6f3;
  }
  .tc-name { font-size: 1rem; font-weight: 650; line-height: 1.25; }
  .tc-program { font-size: 0.78rem; line-height: 1.3; color: rgba(247, 246, 243, 0.78); }
</style>
