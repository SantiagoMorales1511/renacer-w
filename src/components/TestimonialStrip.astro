---
/**
 * Bloque compacto de prueba social: 2–3 miniaturas de video que abren el mismo
 * reproductor con sonido del carrusel (#tc-dialog). No reproduce nada solo,
 * para no competir con el carrusel ni consumir datos.
 */
import { getImage } from 'astro:assets'
import Icon from './Icon.astro'
import { programLabel, type VideoTestimonial } from '../data/testimonials'

interface Props {
  items: VideoTestimonial[]
  title: string
  /** Aclaración opcional bajo el título (p. ej. de qué formación son los testimonios) */
  note?: string
  moreHref?: string
  moreLabel?: string
  class?: string
}
const { items, title, note, moreHref, moreLabel = 'Ver más experiencias', class: className = '' } = Astro.props
const thumbs = await Promise.all(
  items.slice(0, 3).map(async (t) => ({
    t,
    program: programLabel(t),
    s: await getImage({ src: t.poster, width: 240, format: 'webp', quality: 68 }),
    m: await getImage({ src: t.poster, width: 360, format: 'webp', quality: 70 }),
    l: await getImage({ src: t.poster, width: 560, format: 'webp', quality: 72 }),
  })),
)
---

{
  thumbs.length > 0 && (
    <section class:list={['ts', className]} aria-label={title}>
      <div class="wrap">
        <div class="ts-box">
          <div class="ts-head">
            <h2 class="text-[1.12rem] font-semibold leading-snug tracking-[-0.015em] text-petrol sm:text-[1.3rem]">{title}</h2>
            {note && <p class="mt-1.5 text-[0.82rem] leading-snug text-ink-mute">{note}</p>}
            {moreHref && (
              <a href={moreHref} class="mt-3 hidden items-center gap-1.5 text-[0.88rem] font-semibold text-petrol hover:gap-2.5 sm:inline-flex">
                {moreLabel} <Icon name="arrow" size={16} />
              </a>
            )}
          </div>
          <ul class="ts-list">
            {thumbs.map(({ t, program, s, m, l }) => (
              <li>
                <button
                  type="button"
                  class="ts-thumb group"
                  data-open
                  data-full={t.src}
                  data-poster={l.src}
                  data-name={t.name}
                  data-program={program}
                  aria-label={`Ver con sonido el testimonio de ${t.name}, ${program} (${t.duration})`}
                >
                  <span class="ts-media">
                    <img
                      src={m.src}
                      srcset={`${s.src} 240w, ${m.src} 360w`}
                      sizes="(min-width: 768px) 150px, 30vw"
                      width={m.attributes.width}
                      height={m.attributes.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="ts-play" aria-hidden="true"><Icon name="play" size={15} class="ml-0.5" /></span>
                    <span class="ts-time" aria-hidden="true">{t.duration}</span>
                  </span>
                  <span class="ts-name">{t.name}</span>
                  <span class="ts-program">{program}</span>
                </button>
              </li>
            ))}
          </ul>
          {moreHref && (
            <a href={moreHref} class="mt-4 inline-flex items-center gap-1.5 text-[0.88rem] font-semibold text-petrol sm:hidden">
              {moreLabel} <Icon name="arrow" size={16} />
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style is:global>
  .ts-box {
    border-radius: 1.5rem;
    border: 1px solid #e4ded4;
    background: #fff;
    padding: 1.1rem 1.1rem 1.15rem;
  }
  @media (min-width: 768px) {
    .ts-box { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2.5rem; padding: 1.5rem 1.75rem; }
  }
  .ts-list {
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    list-style: none;
  }
  @media (min-width: 768px) {
    .ts-list { margin-top: 0; grid-template-columns: repeat(3, 150px); gap: 0.9rem; }
  }
  .ts-thumb { display: flex; width: 100%; flex-direction: column; text-align: left; }
  .ts-media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.9rem;
    background: #14243d;
  }
  .ts-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    transition: transform 0.5s ease;
  }
  .ts-thumb:hover .ts-media img { transform: scale(1.04); }
  .ts-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 36, 61, 0.35), transparent 45%);
  }
  .ts-play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    height: 2.4rem;
    width: 2.4rem;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(247, 246, 243, 0.95);
    color: #14243d;
    transition: transform 0.2s ease;
  }
  .ts-thumb:hover .ts-play { transform: translate(-50%, -50%) scale(1.08); }
  .ts-time {
    position: absolute;
    bottom: 0.4rem;
    right: 0.45rem;
    z-index: 1;
    font-size: 0.66rem;
    font-weight: 600;
    color: #f7f6f3;
  }
  .ts-name {
    margin-top: 0.45rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8rem;
    font-weight: 650;
    color: #1b2b45;
  }
  .ts-program {
    font-size: 0.7rem;
    line-height: 1.25;
    color: #5e6b80;
  }
</style>
