---
import Icon from './Icon.astro'
import type { Faq } from '../data/faqs'

interface Props {
  items: Faq[]
  id?: string
}
const { items, id } = Astro.props
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<div id={id} class="divide-y divide-cream-line border-y border-cream-line">
  {
    items.map((f) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-[1.05rem] font-semibold leading-snug text-ink marker:hidden sm:py-6 sm:text-lg [&::-webkit-details-marker]:hidden">
          {f.q}
          <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink/15 text-petrol transition-transform duration-200 group-open:rotate-45">
            <Icon name="plus" size={16} />
          </span>
        </summary>
        <p class="-mt-1 max-w-prose pb-6 pr-10 text-[0.98rem] leading-relaxed text-ink-soft">{f.a}</p>
      </details>
    ))
  }
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
