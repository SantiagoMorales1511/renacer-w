---
/**
 * Carrusel circular de testimonios en video, al estilo de las historias.
 * - Solo la tarjeta central reproduce su video completo (sin sonido al inicio).
 * - Tocar el video activa/desactiva el sonido; no lo pausa ni lo amplía.
 * - Al terminar el video avanza al siguiente, siempre en la misma dirección:
 *   en los extremos hay copias visuales (solo poster) y, al llegar a una copia,
 *   el carrusel se reposiciona de forma invisible en la tarjeta real equivalente.
 * - Hay un único <video> que se mueve de tarjeta en tarjeta: nunca suenan dos a la vez
 *   y en iPhone se conserva el permiso de sonido tras el primer toque.
 */
import Icon from './Icon.astro'
import TestimonialCard from './TestimonialCard.astro'
import TestimonialDialog from './TestimonialDialog.astro'
import type { VideoTestimonial } from '../data/testimonials'

interface Props {
  items: VideoTestimonial[]
  eyebrow?: string
  title?: string
  subtitle?: string
  id?: string
  bg?: 'cream' | 'white'
  /** Incluir el reproductor grande (solo lo usan miniaturas o cuadrículas de la página) */
  withDialog?: boolean
}
const {
  items: rawItems,
  eyebrow = 'Experiencias Renacer',
  title = 'Historias que inspiran',
  subtitle = 'Conoce las experiencias de quienes han sido parte de nuestras formaciones.',
  id = 'testimonios',
  bg = 'cream',
  withDialog = false,
} = Astro.props
// Todos los carruseles empiezan con el testimonio de Vany Osorio; el resto conserva su orden.
const FIRST_ID = 'vany'
const first = rawItems.find((t) => t.id === FIRST_ID)
const items = first ? [first, ...rawItems.filter((t) => t !== first)] : rawItems
const n = items.length
const headingId = `${id}-titulo`
// Copias visuales a cada lado para que el paso del último al primero sea continuo.
const k = n > 1 ? Math.min(n, 3) : 0
const before = items.slice(n - k).map((t, j) => ({ t, real: n - k + j }))
const after = items.slice(0, k).map((t, j) => ({ t, real: j }))
---

{
  n > 0 && (
    <section
      id={id}
      class:list={['tc py-14 sm:py-20 lg:py-24', bg === 'white' ? 'bg-white' : 'bg-cream']}
      aria-labelledby={headingId}
      data-carousel
      data-count={n}
    >
      <div class="wrap text-center">
        <p class="text-[0.72rem] font-bold uppercase tracking-[0.2em] text-petrol">{eyebrow}</p>
        <h2 id={headingId} class="title mx-auto mt-4 max-w-3xl text-petrol">
          {title}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-[1.02rem] leading-relaxed text-ink-soft">{subtitle}</p>
      </div>

      <div class="tc-viewport mx-auto mt-10 max-w-[72rem] sm:mt-12" aria-roledescription="carrusel" aria-label={title}>
        <ul class:list={['tc-track no-scrollbar', n === 1 && 'tc-single']} data-track>
          {before.map(({ t, real }) => (
            <li class="tc-slide" data-slide data-clone data-real={real} aria-hidden="true">
              <TestimonialCard item={t} variant="carousel" clone defer />
            </li>
          ))}
          {items.map((t, i) => (
            <li class="tc-slide" data-slide data-real={i} aria-roledescription="diapositiva" aria-label={`${i + 1} de ${n}: ${t.name}`}>
              <TestimonialCard item={t} variant="carousel" defer={i > 2} />
            </li>
          ))}
          {after.map(({ t, real }) => (
            <li class="tc-slide" data-slide data-clone data-real={real} aria-hidden="true">
              <TestimonialCard item={t} variant="carousel" clone defer />
            </li>
          ))}
        </ul>
      </div>

      {n > 1 && (
        <div class="wrap mt-8 flex flex-col items-center gap-4">
          <div class="flex items-center gap-4">
            <button type="button" class="tc-arrow" data-prev aria-label="Testimonio anterior">
              <Icon name="arrow" size={20} class="rotate-180" />
            </button>
            <div class="tc-indicator" aria-hidden="true">
              <span data-indicator style={`width:${100 / n}%`} />
            </div>
            <button type="button" class="tc-arrow" data-next aria-label="Testimonio siguiente">
              <Icon name="arrow" size={20} />
            </button>
            <button type="button" class="tc-pause" data-pause aria-pressed="false">
              <svg class="tc-i-pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
              <svg class="tc-i-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.86l10.2-6.4a1 1 0 0 0 0-1.72L9.5 4.74A1 1 0 0 0 8 5.6Z" /></svg>
              <span class="sr-only" data-pause-label>Pausar carrusel</span>
            </button>
          </div>
          <p class="text-[0.85rem] text-ink-mute">Desliza para conocer más experiencias</p>
          <p class="sr-only" aria-live="polite" data-live />
        </div>
      )}
    </section>
  )
}

{withDialog && n > 0 && <TestimonialDialog />}

<style is:global>
  .tc-viewport { position: relative; }
  .tc-track {
    --card: min(74vw, 300px);
    --gap: 14px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding: 0.5rem calc((100% - var(--card)) / 2) 0.75rem;
    list-style: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
  }
  @media (min-width: 768px) {
    .tc-track { --card: 280px; --gap: 22px; }
  }
  .tc-track.tc-single { justify-content: center; overflow: visible; }
  .tc-slide {
    flex: 0 0 var(--card);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .tc[data-ready] .tc-slide:not([data-active]) .tc-card { transform: scale(0.9); }
  .tc[data-jump] .tc-card,
  .tc[data-jump] .tc-hint,
  .tc[data-jump] .tc-indicator span { transition: none !important; }
  .tc[data-ready] .tc-slide:not([data-active]) .tc-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(247, 246, 243, 0.42);
    pointer-events: none;
  }
  /* La tarjeta central no muestra el botón de play mientras carga su video */
  .tc:not([data-static]) .tc-slide[data-active] .tc-play { opacity: 0; }
  /* Una sola indicación sobre la central: "Toca el video…" en silencio; "Sonido activado" un instante */
  .tc:not([data-sound-on]) .tc-slide[data-active][data-playing] .tc-film { opacity: 1; }
  .tc:not([data-sound-on]) .tc-slide[data-active][data-playing] .tc-hint:not(.tc-hint-on),
  .tc[data-sound-on][data-sound-flash] .tc-slide[data-active] .tc-hint-on { opacity: 1; transform: translate(-50%, 0); }
  .tc-slide[data-active] .tc-media { cursor: pointer; }
  .tc-slide[data-active][data-playing] .tc-smart { opacity: 1; }
  /* Destello de inicio que recorre la barra una vez (decorativo; el relleno sigue el tiempo real) */
  .tc-slide[data-burst] .tc-smart::before { animation: tc-burst 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes tc-burst {
    from { transform: translateX(-100%); opacity: 1; }
    70% { opacity: 1; }
    to { transform: translateX(260%); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .tc-slide[data-burst] .tc-smart::before { animation: none; } }
  .tc-arrow {
    display: none;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: #2f4d7e;
    transition: background-color 0.2s;
  }
  .tc-arrow:hover { background: rgba(47, 77, 126, 0.08); }
  @media (min-width: 640px) { .tc-arrow { display: inline-flex; } }
  .tc-indicator {
    position: relative;
    height: 4px;
    width: 9rem;
    overflow: hidden;
    border-radius: 9999px;
    background: rgba(47, 77, 126, 0.15);
  }
  .tc-indicator span {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 9999px;
    background: #2f4d7e;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tc-pause {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(47, 77, 126, 0.25);
    color: #2f4d7e;
  }
  .tc-pause .tc-i-play,
  .tc-pause[aria-pressed='true'] .tc-i-pause { display: none; }
  .tc-pause[aria-pressed='true'] .tc-i-play { display: block; }
  .tc[data-static]:not([data-started]) .tc-pause { display: none; }
</style>

<script>
  type Conn = { saveData?: boolean; effectiveType?: string }
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  const conn = (navigator as Navigator & { connection?: Conn }).connection
  const lowData = () => !!conn?.saveData || /2g/.test(conn?.effectiveType ?? '')
  const allowAutoplay = () => !reduceMotion.matches && !lowData()
  /** Buffer por delante del video actual a partir del cual se precarga el siguiente */
  const AHEAD_TO_PRELOAD = 6

  const carousels: Carousel[] = []
  let dialogOpen = false
  /** La página terminó de cargar (Hero, CSS, posters): ya se pueden pedir videos sin competir con el LCP */
  let pageIdle = false
  /** El visitante empezó a desplazarse (intención de seguir bajando) */
  let scrolled = false

  class Carousel {
    root: HTMLElement
    track: HTMLElement
    slides: HTMLElement[]
    /** Número de testimonios reales (sin copias) */
    n: number
    /** Índice físico (incluye copias) de la tarjeta central */
    active = -1
    inView = false
    /** La sección está a menos de ~800 px de entrar en pantalla */
    near = false
    userPaused = false
    touching = false
    pendingAdvance = false
    soundOn = false
    blocked = false
    /** El visitante inició la reproducción manualmente (autoplay no permitido) */
    started = false
    /**
     * Como máximo dos <video>: el del testimonio actual y el que precarga el siguiente.
     * Cada uno guarda en data-real el testimonio que tiene cargado; nunca hay dos con el mismo
     * archivo ni más de dos descargas a la vez.
     */
    pool: HTMLVideoElement[] = []
    cur: HTMLVideoElement | null = null
    raf = 0
    scrollRaf = 0
    settleTimer = 0
    flashTimer = 0
    /** Mientras el carrusel se desplaza solo hacia una tarjeta elegida, el scroll no cambia la activa */
    lockUntil = 0
    /** Tarjeta física cuyo video terminó: su barra queda al 100 % mientras se desplaza */
    finished = -1

    constructor(root: HTMLElement) {
      this.root = root
      this.track = root.querySelector('[data-track]')!
      this.slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')]
      this.n = this.slides.filter((s) => !s.hasAttribute('data-clone')).length
      if (!allowAutoplay()) root.dataset.static = ''

      // Visible: reproducir. Cerca: preparar el video con antelación.
      new IntersectionObserver(
        ([e]) => {
          this.inView = e.isIntersecting
          this.update()
        },
        { threshold: 0.25 },
      ).observe(root)
      new IntersectionObserver(
        ([e]) => {
          this.near = e.isIntersecting
          this.warm()
        },
        { rootMargin: '0px 0px 800px 0px' },
      ).observe(root)

      this.track.addEventListener('scroll', () => {
        clearTimeout(this.settleTimer)
        this.settleTimer = window.setTimeout(() => this.onSettle(), 140)
        if (performance.now() < this.lockUntil) return
        cancelAnimationFrame(this.scrollRaf)
        this.scrollRaf = requestAnimationFrame(() => this.setActive(this.nearest()))
      }, { passive: true })

      const down = () => { this.touching = true; this.lockUntil = 0 }
      const up = () => {
        this.touching = false
        clearTimeout(this.settleTimer)
        this.settleTimer = window.setTimeout(() => this.onSettle(), 140)
      }
      this.track.addEventListener('touchstart', down, { passive: true })
      this.track.addEventListener('pointerdown', down, { passive: true })
      for (const t of ['touchend', 'touchcancel', 'pointerup', 'pointercancel']) this.track.addEventListener(t, up, { passive: true })

      this.track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); this.go(this.active + 1, true) }
        if (e.key === 'ArrowLeft') { e.preventDefault(); this.go(this.active - 1, true) }
      })
      root.querySelector('[data-prev]')?.addEventListener('click', () => this.go(this.active - 1, true))
      root.querySelector('[data-next]')?.addEventListener('click', () => this.go(this.active + 1, true))

      // Todo el video es la zona táctil. Un arrastre (deslizar el carrusel) no cuenta como toque.
      this.slides.forEach((slide, p) => {
        const media = slide.querySelector<HTMLElement>('[data-tap]')
        if (!media) return
        let start: { x: number; y: number; left: number } | null = null
        media.addEventListener('pointerdown', (e) => { start = { x: e.clientX, y: e.clientY, left: this.track.scrollLeft } }, { passive: true })
        media.addEventListener('click', (e) => {
          const moved = start && (Math.hypot(e.clientX - start.x, e.clientY - start.y) > 10 || Math.abs(this.track.scrollLeft - start.left) > 6)
          start = null
          // e.detail === 0: activación con teclado (Enter/Espacio)
          if (moved && e.detail !== 0) return
          this.onTap(p)
        })
      })

      const pause = root.querySelector<HTMLButtonElement>('[data-pause]')
      pause?.addEventListener('click', () => {
        this.userPaused = !this.userPaused
        pause.setAttribute('aria-pressed', String(this.userPaused))
        const label = pause.querySelector('[data-pause-label]')
        if (label) label.textContent = this.userPaused ? 'Reanudar carrusel' : 'Pausar carrusel'
        this.update()
      })

      const start = this.physicalOf(0)
      this.track.scrollLeft = this.offsetFor(start)
      this.setActive(start)
      root.dataset.ready = ''
    }

    real(p: number) { return Number(this.slides[p].dataset.real) }
    isClone(p: number) { return this.slides[p]?.hasAttribute('data-clone') }
    physicalOf(r: number) { return this.slides.findIndex((s) => !s.hasAttribute('data-clone') && Number(s.dataset.real) === r) }
    card(p: number) { return this.slides[p].querySelector<HTMLElement>('[data-card]')! }

    offsetFor(p: number) {
      const s = this.slides[p]
      return s.offsetLeft - (this.track.clientWidth - s.offsetWidth) / 2
    }

    nearest() {
      const center = this.track.scrollLeft + this.track.clientWidth / 2
      let best = 0
      let dist = Infinity
      this.slides.forEach((s, i) => {
        const d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - center)
        if (d < dist) { dist = d; best = i }
      })
      return best
    }

    /**
     * Lleva el carrusel a la tarjeta física p (siempre hay una copia a cada lado).
     * La tarjeta elegida se activa y su video arranca de inmediato, mientras el
     * carrusel termina de desplazarse.
     */
    go(p: number, announce = false) {
      if (this.n < 2) return
      const target = Math.max(0, Math.min(this.slides.length - 1, p))
      this.lockUntil = performance.now() + 900
      this.track.scrollTo({ left: this.offsetFor(target), behavior: reduceMotion.matches ? 'auto' : 'smooth' })
      if (announce) {
        const live = this.root.querySelector('[data-live]')
        if (live) live.textContent = `Testimonio ${this.real(target) + 1} de ${this.n}: ${this.card(target).dataset.name ?? ''}`
      }
      this.setActive(target)
      this.update()
    }

    /** Fin del desplazamiento: si quedó en una copia, salto invisible a la tarjeta real (el video se mueve con ella). */
    onSettle() {
      if (this.touching) return
      this.lockUntil = 0
      this.setActive(this.nearest())
      // El video terminó mientras el visitante tocaba el carrusel: ahora sí avanza.
      if (this.pendingAdvance) {
        this.pendingAdvance = false
        if (this.cur?.ended && this.cur.dataset.real === String(this.real(this.active))) { this.go(this.active + 1); return }
      }
      if (this.isClone(this.active)) {
        const clone = this.active
        const realP = this.physicalOf(this.real(clone))
        const delta = this.slides[realP].offsetLeft - this.slides[clone].offsetLeft
        // Sin transiciones durante el salto: la tarjeta real es idéntica a la copia.
        this.root.dataset.jump = ''
        this.track.style.scrollSnapType = 'none'
        this.track.scrollLeft += delta
        this.track.style.scrollSnapType = ''
        // El mismo <video> pasa a la tarjeta real sin detenerse (se mueve en el mismo instante).
        const v = this.cur
        if (v && v.dataset.for === String(clone)) {
          const bar = this.slides[clone].querySelector<HTMLElement>('[data-bar]')?.style.transform
          this.attach(v, realP)
          if (bar) this.slides[realP].querySelector<HTMLElement>('[data-bar]')!.style.transform = bar
          if (this.slides[clone].hasAttribute('data-playing')) this.slides[realP].setAttribute('data-playing', '')
          this.slides[clone].removeAttribute('data-playing')
          this.setBar(clone, 0)
        }
        this.setActive(realP)
        void this.root.offsetWidth
        requestAnimationFrame(() => requestAnimationFrame(() => delete this.root.dataset.jump))
      }
      this.update()
    }

    hydrate(p: number) {
      for (let d = -2; d <= 2; d++) {
        const img = this.slides[p + d]?.querySelector<HTMLImageElement>('img[data-src]')
        if (!img) continue
        img.srcset = img.dataset.srcset ?? ''
        img.src = img.dataset.src ?? ''
        img.removeAttribute('data-src')
      }
    }

    setActive(p: number) {
      if (p === this.active || p < 0) return
      this.hydrate(p)
      // Si la tarjeta nueva es de otro testimonio, el video anterior se detiene y su barra vuelve a cero.
      const v = this.cur
      if (v && v.dataset.real !== String(this.real(p))) this.stop(v)
      this.slides.forEach((s, i) => (i === p ? s.setAttribute('data-active', '') : s.removeAttribute('data-active')))
      this.active = p
      const ind = this.root.querySelector<HTMLElement>('[data-indicator]')
      if (ind) ind.style.transform = `translateX(${this.real(p) * 100}%)`
      this.syncSoundUI()
    }

    shouldPlay() {
      const allowed = (allowAutoplay() && !this.blocked) || this.started || this.soundOn
      return allowed && this.inView && !document.hidden && !dialogOpen && !this.userPaused
    }

    update() {
      if (this.shouldPlay()) this.play()
      else {
        this.cur?.pause()
        this.warm()
      }
    }

    /**
     * Prepara el video de la tarjeta central cuando el visitante empieza a desplazarse hacia el
     * carrusel (y la página ya terminó de cargar el Hero). Quien no hace scroll no descarga video.
     * Si en 6 s no llega al carrusel, se cancela la descarga para no gastar datos.
     */
    parkTimer = 0
    warm() {
      if (!pageIdle || !scrolled || !this.near || !allowAutoplay() || this.blocked || this.cur) return
      const p = this.active
      const v = this.acquire(this.real(p), 'metadata')
      this.attach(v, p)
      v.dataset.burst = '1'
      this.cur = v
      clearTimeout(this.parkTimer)
      this.parkTimer = window.setTimeout(() => {
        if (this.cur !== v || !v.paused || this.inView) return
        v.removeAttribute('src')
        v.load()
        delete v.dataset.real
        this.cur = null
      }, 6000)
    }

    createVideo() {
      const v = document.createElement('video')
      v.muted = true
      v.defaultMuted = true
      v.playsInline = true
      v.loop = false
      v.setAttribute('muted', '')
      v.setAttribute('playsinline', '')
      v.setAttribute('webkit-playsinline', '')
      v.setAttribute('disablepictureinpicture', '')
      v.setAttribute('aria-hidden', 'true')
      v.preload = 'auto'
      v.addEventListener('playing', () => {
        if (v !== this.cur) { v.pause(); return }
        v.dataset.ready = ''
        const slide = this.slides[Number(v.dataset.for)]
        slide?.setAttribute('data-playing', '')
        if (v.dataset.burst) {
          delete v.dataset.burst
          this.burst(slide)
        }
        this.tick()
      })
      v.addEventListener('canplaythrough', () => { if (v === this.cur && !v.paused) this.preloadNext() })
      v.addEventListener('ended', () => { if (v === this.cur) this.onEnded() })
      this.pool.push(v)
      return v
    }

    /** Devuelve el <video> con el testimonio r (reutiliza el precargado o recicla el libre). */
    acquire(r: number, preload: 'auto' | 'metadata' = 'auto') {
      const have = this.pool.find((v) => v.dataset.real === String(r))
      if (have) {
        if (preload === 'auto') have.preload = 'auto'
        return have
      }
      const free = this.pool.length < 2 ? this.createVideo() : this.pool.find((v) => v !== this.cur) ?? this.pool[0]
      free.pause()
      free.removeAttribute('data-ready')
      free.preload = preload
      free.dataset.real = String(r)
      free.src = this.card(this.physicalOf(r)).dataset.full!
      free.load()
      return free
    }

    /** Coloca el <video> en la ranura de la tarjeta física p (moverlo no lo detiene). */
    attach(v: HTMLVideoElement, p: number) {
      const slot = this.slides[p].querySelector('[data-slot]')!
      if (v.parentElement !== slot) slot.append(v)
      v.dataset.for = String(p)
    }

    /** Detiene un video y deja su tarjeta en el poster con la barra en cero. */
    stop(v: HTMLVideoElement) {
      cancelAnimationFrame(this.raf)
      v.pause()
      const p = Number(v.dataset.for)
      this.slides[p]?.removeAttribute('data-playing')
      if (p === this.finished) {
        // Terminó: la barra se queda llena mientras la tarjeta sale y luego vuelve a cero.
        this.finished = -1
        window.setTimeout(() => { if (Number(this.cur?.dataset.for) !== p) this.setBar(p, 0) }, 700)
      } else this.setBar(p, 0)
      v.removeAttribute('data-ready')
      v.dataset.restart = '1'
      if (v === this.cur) this.cur = null
    }

    /** Reproduce el testimonio de la tarjeta central. */
    play() {
      const p = this.active
      const r = this.real(p)
      const v = this.acquire(r)
      if (this.cur && this.cur !== v) this.stop(this.cur)
      const fresh = this.cur !== v || v.dataset.restart === '1'
      this.cur = v
      this.attach(v, p)
      if (fresh) {
        delete v.dataset.restart
        if (v.currentTime > 0) v.currentTime = 0
        v.dataset.burst = '1'
        this.setBar(p, 0)
      }
      if (v.ended) return
      v.muted = !this.soundOn
      v.play().catch((err: DOMException) => {
        if (err?.name !== 'NotAllowedError' || v !== this.cur) return
        if (!v.muted) {
          // El navegador exige un nuevo toque para el audio: se continúa en silencio.
          this.soundOn = false
          this.syncSoundUI()
          v.muted = true
          v.play().catch(() => this.block())
          return
        }
        this.block()
      })
    }

    /** Precarga limitada: solo el siguiente testimonio, cuando el actual ya tiene suficiente buffer. */
    preloadNext() {
      // Solo mientras el actual se está reproduciendo de verdad (no durante la preparación).
      if (this.n < 2 || lowData() || reduceMotion.matches || !this.cur || this.cur.paused) return
      const next = (Number(this.cur.dataset.real) + 1) % this.n
      if (this.pool.some((v) => v.dataset.real === String(next))) return
      const v = this.acquire(next)
      this.attach(v, this.physicalOf(next))
    }

    /** Autoplay bloqueado: queda el poster con el botón de reproducción, sin avance automático. */
    block() {
      this.blocked = true
      this.root.dataset.static = ''
      if (this.cur) this.stop(this.cur)
    }

    setBar(p: number, value: number) {
      const bar = this.slides[p]?.querySelector<HTMLElement>('[data-bar]')
      if (bar) bar.style.transform = `translateX(${((Math.max(0, Math.min(1, value)) - 1) * 100).toFixed(3)}%)`
    }

    /** Destello de luz que recorre la barra al comenzar cada testimonio (decorativo). */
    burst(slide?: HTMLElement) {
      if (!slide || reduceMotion.matches) return
      slide.removeAttribute('data-burst')
      void slide.offsetWidth
      slide.setAttribute('data-burst', '')
      window.setTimeout(() => slide.removeAttribute('data-burst'), 1000)
    }

    /**
     * Smart progress bar: currentTime / duration del video real, en cada fotograma.
     * Entre dos actualizaciones de currentTime se interpola con el reloj (máx. 0,25 s y nunca
     * más allá de la duración); si el video espera datos o se pausa, la barra se detiene.
     */
    tick() {
      cancelAnimationFrame(this.raf)
      const v = this.cur
      if (!v) return
      let lastTime = -1
      let lastAt = 0
      const step = (now: number) => {
        if (v !== this.cur) return
        if (v.duration) {
          if (v.currentTime !== lastTime) { lastTime = v.currentTime; lastAt = now }
          const ahead = v.paused || v.readyState < 3 ? 0 : Math.min(0.25, (now - lastAt) / 1000) * v.playbackRate
          const ratio = Math.min(v.duration, lastTime + ahead) / v.duration
          this.setBar(Number(v.dataset.for), ratio)
          // Con suficiente buffer del actual, se precarga el siguiente (preloadNext no repite si ya está).
          const b = v.buffered
          if (b.length && b.end(b.length - 1) - v.currentTime >= AHEAD_TO_PRELOAD) this.preloadNext()
        }
        if (!v.paused && !v.ended) this.raf = requestAnimationFrame(step)
      }
      this.raf = requestAnimationFrame(step)
    }

    onEnded() {
      this.setBar(this.active, 1)
      this.finished = this.active
      if (this.n < 2 || this.userPaused || reduceMotion.matches) return
      // Si el visitante está deslizando, el avance espera a que suelte.
      if (this.touching) { this.pendingAdvance = true; return }
      this.go(this.active + 1)
    }

    /**
     * Toque en cualquier parte del video:
     * - tarjeta lateral: se selecciona;
     * - tarjeta central reproduciéndose: activa/desactiva el sonido sin pausar ni reiniciar;
     * - tarjeta central sin reproducir (autoplay no permitido): empieza con sonido.
     */
    onTap(p: number) {
      if (p !== this.active) {
        this.go(p, true)
        return
      }
      const v = this.cur
      const playing = !!v && v.dataset.for === String(p) && !v.paused
      if (!playing) {
        this.started = true
        this.blocked = false
        this.userPaused = false
        this.root.dataset.started = ''
        this.setSound(true)
        this.play()
        this.unlockSpare()
        return
      }
      this.setSound(!this.soundOn)
      // Dentro del mismo toque: el navegador permite el audio y el video sigue en el mismo segundo.
      v!.muted = !this.soundOn
      if (this.soundOn) {
        v!.play().catch(() => {})
        this.unlockSpare()
      }
    }

    /**
     * iPhone solo permite audio en un <video> que se reprodujo tras un toque. Dentro del mismo
     * toque se "habilita" también el segundo elemento (play + pausa inmediata), para que el
     * siguiente testimonio pueda continuar con sonido.
     */
    unlockSpare() {
      const spare = this.pool.find((x) => x !== this.cur)
      if (!spare || !spare.src) return
      spare.muted = false
      const pr = spare.play()
      spare.pause()
      spare.muted = true
      pr?.catch(() => {})
    }

    /**
     * Teclas de volumen del dispositivo (solo en navegadores que las informan a la página:
     * algunos Android y teclados con teclas multimedia; iPhone no las expone a la web).
     */
    onVolumeKey() {
      const v = this.cur
      if (this.soundOn || !this.inView || dialogOpen || !v || v.paused || v.dataset.for !== String(this.active)) return
      this.setSound(true)
      v.muted = false
      v.play().catch(() => {
        // El navegador no aceptó la tecla como interacción: se mantiene en silencio.
        this.setSound(false)
        v.muted = true
        v.play().catch(() => {})
      })
    }

    setSound(on: boolean) {
      this.soundOn = on
      this.syncSoundUI()
      // "Sonido activado" se muestra un instante y luego se oculta.
      clearTimeout(this.flashTimer)
      this.root.toggleAttribute('data-sound-flash', on)
      if (on) this.flashTimer = window.setTimeout(() => this.root.removeAttribute('data-sound-flash'), 1400)
    }

    syncSoundUI() {
      this.root.toggleAttribute('data-sound-on', this.soundOn)
      this.slides.forEach((slide, i) => {
        const media = slide.querySelector<HTMLElement>('[data-tap]')
        if (!media) return
        const on = this.soundOn && i === this.active
        const label = on ? media.dataset.labelOn : media.dataset.labelOff
        if (label) media.setAttribute('aria-label', label)
      })
    }
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => carousels.push(new Carousel(el)))
  document.addEventListener('visibilitychange', () => carousels.forEach((c) => c.update()))
  const VOLUME_KEYS = ['AudioVolumeUp', 'AudioVolumeDown', 'VolumeUp', 'VolumeDown']
  document.addEventListener('keydown', (e) => {
    if (VOLUME_KEYS.includes(e.key)) carousels.forEach((c) => c.onVolumeKey())
  })
  reduceMotion.addEventListener?.('change', () => carousels.forEach((c) => c.update()))

  // Los videos esperan a que la página termine de cargar (Hero y posters primero).
  const markIdle = () => {
    const ric = (window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number }).requestIdleCallback
    const go = () => { pageIdle = true; carousels.forEach((c) => c.warm()) }
    if (ric) ric(go, { timeout: 1500 })
    else window.setTimeout(go, 300)
  }
  if (document.readyState === 'complete') markIdle()
  else window.addEventListener('load', markIdle, { once: true })
  const onScroll = () => {
    if (window.scrollY < 24) return
    scrolled = true
    window.removeEventListener('scroll', onScroll)
    carousels.forEach((c) => c.warm())
  }
  window.addEventListener('scroll', onScroll, { passive: true })

  // Si en la página se abre el reproductor grande (miniaturas), el carrusel se pausa.
  document.addEventListener('tc:dialog', (e) => {
    dialogOpen = (e as CustomEvent<{ open: boolean }>).detail.open
    carousels.forEach((c) => c.update())
  })
</script>
