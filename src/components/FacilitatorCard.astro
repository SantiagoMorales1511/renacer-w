---
import { Picture } from 'astro:assets'
import type { Person } from '../data/people'

interface Props {
  person: Person
  modules?: string
  role?: string
}
const { person, modules, role = person.role } = Astro.props
---

<article class="card flex flex-col overflow-hidden sm:flex-row md:flex-col">
  <div class="aspect-[4/5] overflow-hidden bg-cream-warm sm:w-2/5 sm:shrink-0 md:w-full">
    <Picture
      src={person.photo}
      alt={`Retrato de ${person.name}`}
      widths={[360, 560, 800]}
      sizes="(min-width: 768px) 420px, (min-width: 640px) 40vw, 100vw"
      formats={['avif', 'webp']}
      class="h-full w-full object-cover"
      style={`object-position: ${person.focus ?? '50% 30%'}`}
      loading="lazy"
    />
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    {role && <p class="text-[0.72rem] font-bold uppercase tracking-[0.18em] text-gold-deep">{role}</p>}
    <h3 class="mt-2 text-[1.4rem] leading-tight">{person.name}</h3>
    <ul class="mt-4 flex flex-wrap gap-2">
      {person.credentials.map((c) => <li class="pill">{c}</li>)}
    </ul>
    {modules && <p class="mt-auto pt-6 text-[0.88rem] font-semibold text-petrol">{modules}</p>}
  </div>
</article>
