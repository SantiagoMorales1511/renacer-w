---
/**
 * Medición del sitio: aviso de consentimiento + Meta Pixel + Google Tag Manager / Google Ads.
 * Toda la lógica está en src/lib/tracking (ver docs/medicion.md). Este componente solo pinta
 * el aviso (mismo texto y diseño de siempre) y entrega la configuración al navegador.
 */
import { tracking, trackingOn } from '../data/tracking'

interface Props {
  /** La página tiene la barra fija de WhatsApp en móvil: el aviso se sube para no taparla */
  sticky?: boolean
}
const { sticky = false } = Astro.props
---

{
  trackingOn && (
    <div
      id="rn-consent"
      role="dialog"
      aria-modal="false"
      aria-labelledby="rn-consent-t"
      hidden
      class:list={['rn-consent', sticky && 'rn-consent--sticky']}
    >
      <p id="rn-consent-t" class="rn-consent__text">Usamos cookies para medir las visitas y mejorar nuestros anuncios.</p>
      <div class="rn-consent__actions">
        <button type="button" data-consent="denied" class="rn-consent__btn rn-consent__btn--no">Rechazar</button>
        <button type="button" data-consent="granted" class="rn-consent__btn rn-consent__btn--yes">Aceptar</button>
      </div>
    </div>
  )
}

<style is:global>
  .rn-consent {
    position: fixed;
    z-index: 55;
    left: 1rem;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    max-width: 30rem;
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    background: #f7f6f3;
    color: #1f2a37;
    box-shadow: 0 10px 40px rgba(20, 30, 40, 0.22);
    border: 1px solid rgba(20, 30, 40, 0.08);
    line-height: 1.5;
  }
  .rn-consent--sticky {
    bottom: calc(6.25rem + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 768px) {
    .rn-consent {
      right: auto;
      left: 1.5rem;
      bottom: 1.5rem;
    }
    .rn-consent--sticky {
      bottom: 1.5rem;
    }
  }
  .rn-consent[hidden] {
    display: none;
  }
  .rn-consent__text {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }
  .rn-consent__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }
  .rn-consent__btn {
    flex: 1;
    min-height: 3rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: 2px solid #1f2a37;
  }
  .rn-consent__btn--no {
    background: #fff;
    color: #1f2a37;
  }
  .rn-consent__btn--yes {
    background: #1f2a37;
    color: #fff;
  }
</style>

{trackingOn && <script type="application/json" id="rn-tracking" set:html={JSON.stringify(tracking)} />}

<script>
  import { initTracking } from '../lib/tracking'
  import type { TrackingConfig } from '../data/tracking'

  const cfgEl = document.getElementById('rn-tracking')
  if (cfgEl) {
    try {
      initTracking(JSON.parse(cfgEl.textContent || '{}') as TrackingConfig, document.getElementById('rn-consent'))
    } catch {
      /* configuración ilegible: el sitio funciona igual, sin medición */
    }
  }
</script>
